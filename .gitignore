# Python
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment / secrets
.env

# Data is never committed (see docs/dataset.md for how to get it).
# The exception is a handful of small JSON files with measured results,
# so the numbers quoted in the docs can be checked against the source.
data/raw/
data/processed/*
!data/processed/eda_stats.json
!data/processed/baseline_results.json
!data/processed/transformer_results.json
!data/processed/transformer_full_results.json
!data/processed/test_results.json

# Model weights are large binaries and stay out of git.
# The Docker image copies them in from the local build context instead.
*.pt
*.bin
*.safetensors

# MLflow local tracking store
mlruns/
mlflow.db

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
